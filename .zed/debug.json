// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Debug: Savepod Manifest",
    "adapter": "CodeLLDB",
    "request": "launch",
    "sourceLanguages": ["rust"],
    "build": {
      "command": "cargo",
      "args": ["build"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/savepod-cli",
    "args": ["manifest"],
  },
  {
    "adapter": "CodeLLDB",
    "label": "cargo test -p savepod-lib --all-targets",
    "build": {
      "label": "cargo test -p savepod-lib --all-targets",
      "command": "cargo",
      "args": ["test", "--package", "savepod-lib", "--all-targets", "--no-run"],
      "env": {
        "RUSTC_TOOLCHAIN": "/usr/lib/sdk/rust-stable",
      },
      "cwd": "$ZED_WORKTREE_ROOT",
      "use_new_terminal": false,
      "allow_concurrent_runs": false,
      "reveal": "always",
      "reveal_target": "dock",
      "hide": "never",
      "tags": [],
      "shell": "system",
      "show_summary": false,
      "show_command": false,
      "save": "none",
      "hooks": [],
    },
    "sourceLanguages": ["rust"],
  },
]
